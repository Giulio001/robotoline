    "check": "node --check server.js && node --input-type=module --check < public/game.js && node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.1.0",
    "socket.io": "^4.8.1",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3"
  }
}
