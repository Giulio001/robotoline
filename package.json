{
  "name": "terranovaland",
  "version": "1.4.1",
  "private": true,
  "description": "Terranovaland - multiplayer voxel adventure for the web",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
